# Copy this file to .env and fill in your own values. Never commit .env.

# --- Supabase (database + auth) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, used by the webhook. Keep secret.
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- PayPal sandbox (through the Lovable connector gateway) ---
LOVABLE_API_KEY=                    # server only. Also used for the AI gateway.
PAYPAL_API_KEY=                     # server only. Connector connection key.
PAYPAL_WEBHOOK_ID=                  # server only. From your PayPal sandbox webhook.
VITE_LOVABLE_CONNECTOR_PAYPAL_CLIENT_ID=
